# =============================================================================
# Vorlage für die lokalen Einstellungen der Shop-Plattform.
# Diese Datei enthält KEINE echten Geheimnisse. `pnpm dev` (oder `pnpm env:init`)
# erzeugt daraus die Datei `.env` und ersetzt jeden Platzhalter durch einen
# frischen Zufallswert. `.env` wird nie eingecheckt (Sicherheit 5.10).
#
# Platzhalter:
#   __SECRET__   48 zufällige Zeichen (Buchstaben, Ziffern, - und _)
#   __HEX32__    32 zufällige Byte als 64 Hex-Zeichen
#   __KEY32__    32 zufällige Byte als Base64 (Hauptschlüssel)
#   __S3_KEY_ID__  Zugangskennung für den Objektspeicher (GK + 24 Hex-Zeichen)
# =============================================================================

# --- Allgemein ---
SHOP_ENV=local
SHOP_DOMAIN=localhost
SHOP_HTTP_PORT=80
SHOP_HTTPS_PORT=443
# Nur lokal und nur auf 127.0.0.1 freigegeben (infra/compose.local.yaml)
SHOP_DB_PORT=5432
SHOP_S3_PORT=3900

# --- Datenbank (PostgreSQL 18) ---
# Nur für die Einrichtung. Die Anwendung benutzt eigene Rollen (ab Etappe E3).
POSTGRES_SUPERUSER_PASSWORD=__SECRET__

# --- Objektspeicher (Garage) ---
GARAGE_RPC_SECRET=__HEX32__
GARAGE_ADMIN_TOKEN=__SECRET__
GARAGE_METRICS_TOKEN=__SECRET__
SHOP_S3_ACCESS_KEY_ID=__S3_KEY_ID__
SHOP_S3_SECRET_ACCESS_KEY=__HEX32__
SHOP_S3_BUCKET_PUBLIC=media-public
SHOP_S3_BUCKET_PRIVATE=media-private

# --- Test-Mails (Mailpit) ---
# Anmeldung an der Mailpit-Oberfläche unter https://mail.localhost
MAILPIT_UI_USER=shop
MAILPIT_UI_PASSWORD=__SECRET__

# --- Hauptschlüssel für verschlüsselte Werte (TOTP-Geheimnisse, ab E6) ---
SHOP_MASTER_KEY_V1=__KEY32__
