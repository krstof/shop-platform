---
// Shop-Bereiche aus dem Baukasten: Bühne (großes Bild mit Begrüßung), Empfehlungen, „Neu im Shop“ und
// Kategorien-Kacheln, dazu Bestseller (14.11.2026). Sie dürfen mehrfach und auf eigenen Seiten vorkommen; ohne eigenen Inhalt
// (ältere Daten) gilt der Inhalt der Startseite.
import Produktkarte from "./Produktkarte.astro";
import {
  anzahl,
  buttonHref,
  isExternal,
  spaltenKlasse,
  type StoreHome,
  type StoreSection,
} from "../lib/design.js";
import type { StoreCategory, StoreProduct } from "../lib/store-api.js";

interface Props {
  block: StoreSection;
  home: StoreHome;
  shopName: string;
  shop: string;
  /** Alle sichtbaren Produkte (für Empfehlungen). */
  produkte: readonly StoreProduct[];
  /** Die neuesten lieferbaren Produkte (für „Neu im Shop“). */
  neu: readonly StoreProduct[];
  /** Die meistverkauften Produkte (für „Bestseller“). */
  bestseller: readonly StoreProduct[];
  kategorien: readonly StoreCategory[];
  /** Die erste Bühne einer Startseite ist die Hauptüberschrift. */
  hauptueberschrift: boolean;
}
const {
  block: b,
  home,
  shopName,
  shop,
  produkte,
  neu,
  bestseller,
  kategorien,
  hauptueberschrift,
} = Astro.props;
const id = `bereich-${b.id}`;

const titel = b.type === "hero" ? (b.title ?? home.heroTitle) : "";
const text = b.type === "hero" ? (b.text ?? home.heroText) : "";
const bild = b.type === "hero" ? (b.image === undefined ? home.heroImage : b.image) : null;
const nachId = new Map(produkte.map((p) => [p.id, p]));
const empfohlen =
  b.type === "featured"
    ? (b.productIds ?? home.featuredProductIds)
        .map((pid) => nachId.get(pid))
        .filter((p): p is StoreProduct => p !== undefined)
    : [];
const H = hauptueberschrift ? "h1" : "h2";

// Zuschnitt-Punkt des Bühnenbildes: ohne Angabe bleibt die Mitte stehen. Am Handy gilt ein eigener
// Punkt, weil ein breites Foto dort viel enger beschnitten wird. Der Punkt wird auf Viertelschritte
// gerundet und als Klasse gesetzt, weil die Sicherheitsregeln des Shops keine Stile in der Seite
// erlauben (CSP, style-src 'self').
const stufe = (wert: number | undefined, ersatz: number): number => {
  if (typeof wert !== "number" || !Number.isFinite(wert)) return ersatz;
  return Math.min(100, Math.max(0, Math.round(wert / 25) * 25));
};
const fokusX = b.type === "hero" ? stufe(b.focusX, 50) : 50;
const fokusY = b.type === "hero" ? stufe(b.focusY, 50) : 50;
const fokusKlassen =
  b.type === "hero" && bild !== null
    ? [
        `fokus-x-${fokusX}`,
        `fokus-y-${fokusY}`,
        `fokus-handy-x-${stufe(b.focusMobileX, fokusX)}`,
        `fokus-handy-y-${stufe(b.focusMobileY, fokusY)}`,
      ]
    : [];

// Button in der Bühne: nur mit Beschriftung und erlaubtem Ziel.
const knopfZiel = b.type === "hero" && b.buttonUrl !== undefined ? buttonHref(b.buttonUrl, shop) : undefined;
const knopfText = b.type === "hero" ? (b.buttonLabel ?? "").trim() : "";
const knopfExtern = knopfZiel !== undefined && isExternal(knopfZiel);

// Einstellungen der Produktlisten (Kristof 22.11.2026): wie viele, wie viele Spalten, Button darunter.
const spalten = spaltenKlasse(b);
const alleAnsehen = b.showAll === true && b.type !== "categories";
const zeigEmpfohlen = empfohlen.slice(0, anzahl(b, empfohlen.length));
const zeigNeu = neu.slice(0, anzahl(b, 4));
const zeigBestseller = bestseller.slice(0, anzahl(b, 4));
const zeigKategorien = kategorien.slice(0, anzahl(b, kategorien.length));
---

{b.type === "hero" && (
  <section class:list={["buehne", { "buehne-bild": bild !== null }]} aria-labelledby={id}>
    {bild !== null && (
      <img
        class:list={["buehne-foto", fokusKlassen]}
        src={bild.url}
        alt=""
        width={bild.width}
        height={bild.height}
        fetchpriority={hauptueberschrift ? "high" : undefined}
        loading={hauptueberschrift ? undefined : "lazy"}
      />
    )}
    <div class="buehne-text">
      <H id={id}>{titel !== "" ? titel : `Willkommen bei ${shopName}`}</H>
      <p>{text !== "" ? text : "Schön, dass du da bist. Stöbere durch unser Sortiment."}</p>
      {knopfZiel !== undefined && knopfText !== "" && (
        <p class="buehne-knopf">
          <a
            href={knopfZiel}
            class="knopf"
            target={knopfExtern ? "_blank" : undefined}
            rel={knopfExtern ? "noopener noreferrer" : undefined}
          >
            {knopfText}
          </a>
        </p>
      )}
    </div>
  </section>
)}

{b.type === "featured" && zeigEmpfohlen.length > 0 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{b.heading ? b.heading : "Empfohlen"}</h2>
    <ul class:list={["raster", ...spalten]}>
      {zeigEmpfohlen.map((p) => (
        <Produktkarte produkt={p} shop={shop} />
      ))}
    </ul>
    {alleAnsehen && (
      <p class="alle-ansehen">
        <a href={`/${shop}/produkte`} class="knopf knopf-zweit">
          Alle Produkte ansehen
        </a>
      </p>
    )}
  </section>
)}

{b.type === "new" && zeigNeu.length > 1 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{b.heading ? b.heading : "Neu im Shop"}</h2>
    <ul class:list={["raster", ...spalten]}>
      {zeigNeu.map((p) => (
        <Produktkarte produkt={p} shop={shop} />
      ))}
    </ul>
    {alleAnsehen && (
      <p class="alle-ansehen">
        <a href={`/${shop}/produkte`} class="knopf knopf-zweit">
          Alle Produkte ansehen
        </a>
      </p>
    )}
  </section>
)}

{b.type === "bestseller" && zeigBestseller.length > 0 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{b.heading ? b.heading : "Bestseller"}</h2>
    <ul class:list={["raster", ...spalten]}>
      {zeigBestseller.map((p) => (
        <Produktkarte produkt={p} shop={shop} />
      ))}
    </ul>
    {alleAnsehen && (
      <p class="alle-ansehen">
        <a href={`/${shop}/produkte`} class="knopf knopf-zweit">
          Alle Produkte ansehen
        </a>
      </p>
    )}
  </section>
)}

{b.type === "categories" && zeigKategorien.length > 0 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{b.heading ? b.heading : "Kategorien"}</h2>
    <ul class:list={["kategorien", ...spalten]}>
      {zeigKategorien.map((k) => (
        <li>
          <a href={`/${shop}/kategorie/${k.slug}`} class:list={{ "mit-bild": k.image != null }}>
            {k.image != null && (
              <img
                class="kachel-bild"
                src={k.image.thumbnailUrl}
                alt=""
                width="400"
                height="300"
                loading="lazy"
              />
            )}
            <strong>{k.name}</strong>
            {k.description && <span class="klein">{k.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
