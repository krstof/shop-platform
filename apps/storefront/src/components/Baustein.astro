---
// Inhaltsbausteine (Baukasten): Text, Text mit Bild, Bild, Video, Karte, Abstand, Knopf, Zitat,
// Trennlinie, Fragen und Antworten (aufklappbar ohne JavaScript) und Bildergalerie.
// Video und Karte kommen von fremden Servern; sie laden erst, wenn die Besucherin zustimmt
// (Cookie „externe-inhalte“). Bis dahin steht dort ein Hinweis mit Knopf, ganz ohne JavaScript.
import { absaetze } from "../lib/format.js";
import Vertrauenssymbol from "./Vertrauenssymbol.astro";
import {
  buttonHref,
  gruppenInhalt,
  gruppenKlassen,
  isExternal,
  mapUrls,
  videoEmbedUrl,
  type StoreBlock,
} from "../lib/design.js";

interface Props {
  block: Exclude<StoreBlock, { type: "hero" | "featured" | "categories" | "new" }>;
  shop: string;
  /** Hat die Besucherin externe Inhalte erlaubt? */
  extern: boolean;
}
const { block: b, shop, extern } = Astro.props;
// Gruppe (22.11.2026): ein Baustein, der andere Bausteine enthält. Sie zeichnet sich selbst noch einmal
// über `Astro.self`; tiefer als eine Ebene geht es nicht, weil in einer Gruppe keine Gruppe stecken darf.
const gruppe = b.type === "group" ? gruppenInhalt(b) : [];
const video = b.type === "video" ? videoEmbedUrl(b.provider, b.videoId) : undefined;
const karte = b.type === "map" ? mapUrls(b.address) : undefined;
const anbieter = b.type === "video" ? (b.provider === "youtube" ? "YouTube" : "Vimeo") : "Google Maps";
const ziel = b.type === "button" ? buttonHref(b.url, shop) : undefined;
---

{b.type === "group" && gruppe.length > 0 && (
  <section class:list={["baustein", "baustein-gruppe", ...gruppenKlassen(b)]}>
    <div class="gruppe-raster">
      {gruppe.map((k) => (
        <Astro.self block={k} shop={shop} extern={extern} />
      ))}
    </div>
  </section>
)}

{b.type === "text" && (
  <section class="baustein baustein-text">
    {b.heading !== "" && <h2>{b.heading}</h2>}
    {absaetze(b.text).map((a) => (
      <p class="text">{a}</p>
    ))}
  </section>
)}

{b.type === "textImage" && (
  <section class:list={["baustein", "baustein-textbild", { "bild-links": b.imageSide === "left" }]}>
    <div class="textbild-text">
      {b.heading !== "" && <h2>{b.heading}</h2>}
      {absaetze(b.text).map((a) => (
        <p class="text">{a}</p>
      ))}
    </div>
    {b.image !== null && (
      <img
        class="textbild-bild"
        src={b.image.url}
        alt=""
        width={b.image.width}
        height={b.image.height}
        loading="lazy"
      />
    )}
  </section>
)}

{b.type === "image" && (
  <figure class="baustein baustein-bild">
    <img src={b.image.url} alt={b.caption} width={b.image.width} height={b.image.height} loading="lazy" />
    {b.caption !== "" && <figcaption class="klein">{b.caption}</figcaption>}
  </figure>
)}

{(b.type === "video" || b.type === "map") && (
  <section class="baustein baustein-extern">
    {extern && video !== undefined && (
      <div class="einbettung video">
        <iframe
          src={video}
          title="Video"
          loading="lazy"
          allow="encrypted-media; picture-in-picture; fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
        />
      </div>
    )}
    {extern && karte !== undefined && (
      <>
        <div class="einbettung karte">
          <iframe
            src={karte.embed}
            title={`Karte: ${b.type === "map" ? b.address : ""}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            sandbox="allow-scripts allow-same-origin allow-popups"
          />
        </div>
        <p class="klein">
          <a href={karte.link} target="_blank" rel="noopener noreferrer">
            In Google Maps öffnen
          </a>
        </p>
      </>
    )}
    {!extern && (
      <div class="extern-hinweis">
        <p>
          <strong>{b.type === "video" ? "Video" : `Karte: ${b.type === "map" ? b.address : ""}`}</strong>
        </p>
        <p class="klein">
          Hier ist Inhalt von {anbieter} eingebunden. Beim Anzeigen erhält {anbieter} Daten wie deine
          IP-Adresse.
        </p>
        <form method="post" action={`/${shop}/externe-inhalte`}>
          <input type="hidden" name="zurueck" value={Astro.url.pathname} />
          <button type="submit" class="knopf-klein">
            Externe Inhalte anzeigen
          </button>
        </form>
      </div>
    )}
  </section>
)}

{b.type === "spacer" && <div class:list={["baustein-abstand", `abstand-${b.size}`]} aria-hidden="true" />}

{b.type === "button" && ziel !== undefined && (
  <p class="baustein baustein-knopf">
    <a
      href={ziel}
      class:list={["knopf", { "knopf-zweit": b.style === "secondary" }]}
      target={isExternal(ziel) ? "_blank" : undefined}
      rel={isExternal(ziel) ? "noopener noreferrer" : undefined}
    >
      {b.label}
    </a>
  </p>
)}

{b.type === "quote" && (
  <figure class="baustein baustein-zitat">
    <blockquote>
      {absaetze(b.text).map((a) => (
        <p>{a}</p>
      ))}
    </blockquote>
    {b.author !== "" && <figcaption>{b.author}</figcaption>}
  </figure>
)}

{b.type === "divider" && <hr class="baustein baustein-linie" />}

{b.type === "trust" && b.items.length > 0 && (
  <ul class="baustein vertrauen">
    {b.items.map((i) => (
      <li>
        <Vertrauenssymbol name={i.icon} />
        <span>
          <b>{i.title}</b>
          {i.text !== "" && <span class="klein">{i.text}</span>}
        </span>
      </li>
    ))}
  </ul>
)}

{b.type === "faq" && (
  <section class="baustein baustein-faq">
    {b.heading !== "" && <h2>{b.heading}</h2>}
    {b.items.map((i) => (
      <details>
        <summary>{i.question}</summary>
        {absaetze(i.answer).map((a) => (
          <p class="text">{a}</p>
        ))}
      </details>
    ))}
  </section>
)}

{b.type === "gallery" && (
  <figure class="baustein baustein-galerie">
    <div class:list={["galerie-raster", `galerie-${Math.min(b.images.length, 4)}`]}>
      {b.images.map((i) => (
        <img src={i.url} alt="" width={i.width} height={i.height} loading="lazy" />
      ))}
    </div>
    {b.caption !== "" && <figcaption class="klein">{b.caption}</figcaption>}
  </figure>
)}
