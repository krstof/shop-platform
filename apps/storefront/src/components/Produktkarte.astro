---
import type { StoreProduct } from "../lib/store-api.js";
import { euro } from "../lib/format.js";
import { istNeu } from "../lib/neu.js";

interface Props {
  produkt: StoreProduct;
  shop: string;
}
const { produkt: p, shop } = Astro.props;
const bild = p.images[0];
// Zweites Bild beim Überfahren (22.11.2026, docs/08 Punkt 5): zeigt Rückseite, Detail oder das
// Produkt am Menschen, ohne dass jemand klicken muss. Nur am Computer, am Handy gibt es kein
// Überfahren; geladen wird es erst, wenn die Karte sichtbar ist.
const statt = p.compareAtPrice ?? null;
const zweites = p.images[1];
const neu = statt === null && istNeu(p.publishedAt, new Date(), p.newBadge ?? "auto");
---

<li class="karte">
  <a href={`/${shop}/produkt/${p.slug}`} class="karte-link">
    {bild === undefined ? (
      <span class="bild bild-leer" aria-hidden="true" />
    ) : (
      <span class="bild-paar">
        <img
          class="bild"
          src={bild.thumbnailUrl}
          alt=""
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
        />
        {zweites !== undefined && (
          <img
            class="bild bild-zweit"
            src={zweites.thumbnailUrl}
            alt=""
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    )}
    {statt !== null && <span class="angebot-marke">Angebot</span>}
    {neu && <span class="angebot-marke neu-marke">Neu</span>}
    <span class="karte-name">{p.name}</span>
  </a>
  <p class="karte-preis">
    {p.price !== null && (
      <strong class:list={{ "preis-angebot": statt !== null }}>{euro(p.price.amount)}</strong>
    )}
    {statt !== null && (
      <s class="preis-alt">
        <span class="unsichtbar">statt </span>
        {euro(statt.amount)}
      </s>
    )}
  </p>
  {!p.inStock && <p class="hinweis-aus">Zurzeit ausverkauft</p>}
</li>
