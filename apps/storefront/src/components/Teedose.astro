---
// Schlichte Abbildung einer Teedose als SVG, bis es echte Produktbilder gibt (E9/E19).
// Rein schmückend, deshalb für Screenreader ausgeblendet.
interface Props {
  farbe: string;
  name: string;
}
const { farbe, name } = Astro.props;
const kurz = name.split(" ")[0] ?? name;
// Lange Namen kleiner setzen, damit sie auf das Etikett passen.
const groesse = Math.min(15, Math.floor(150 / kurz.length));
---

<svg class="dose" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <rect width="200" height="200" fill="var(--flaeche)"></rect>
  <ellipse cx="100" cy="172" rx="52" ry="8" fill="#000" opacity="0.08"></ellipse>
  <rect x="52" y="44" width="96" height="128" rx="10" fill={farbe}></rect>
  <rect x="48" y="34" width="104" height="22" rx="6" fill={farbe}></rect>
  <rect x="48" y="34" width="104" height="22" rx="6" fill="#000" opacity="0.18"></rect>
  <rect x="58" y="84" width="84" height="52" rx="4" fill="#fffaf2" opacity="0.92"></rect>
  <text
    x="100"
    y="116"
    text-anchor="middle"
    font-family="Georgia, 'Times New Roman', serif"
    font-size={groesse}
    fill="#2b2622"
  >
    {kurz}
  </text>
  <rect x="58" y="56" width="10" height="110" rx="5" fill="#fff" opacity="0.16"></rect>
</svg>
