---
// Startseite der Plattform (M4): führt zu den Testshops.
import "../styles/shop.css";
const testshops = [
  { handle: "teeladen", name: "Teeladen", text: "Grüntee, Schwarztee und Kräuter." },
  { handle: "modeladen", name: "Modeladen", text: "T-Shirts, Hemden und Mützen." },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Slopify</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="breite leer">
      <h1 class="slopify-titel">
        <img src="/favicon.svg" alt="" width="40" height="40" /> slopify
      </h1>
      <p>Ein Lern-Experiment. Hier sind die Testshops:</p>
      <ul class="kategorien">
        {testshops.map((s) => (
          <li>
            <a href={`/${s.handle}`}>
              <strong>{s.name}</strong>
              <span class="klein">{s.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
