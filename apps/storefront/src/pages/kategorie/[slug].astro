---
import type { GetStaticPaths } from "astro";
import Shop from "../../layouts/Shop.astro";
import Produktkarte from "../../components/Produktkarte.astro";
import { KATEGORIEN, kategorie, produkteIn } from "../../vorschau/daten.js";

export const getStaticPaths = (() =>
  KATEGORIEN.map((k) => ({ params: { slug: k.slug } }))) satisfies GetStaticPaths;

const k = kategorie(String(Astro.params.slug));
const produkte = produkteIn(k.slug);
---

<Shop titel={k.name} beschreibung={k.beschreibung}>
  <nav class="pfadleiste" aria-label="Brotkrümelnavigation">
    <ol>
      <li>
        <a href="/">Startseite</a>
      </li>
      <li>
        <a href={`/kategorie/${k.slug}/`} aria-current="page">
          {k.name}
        </a>
      </li>
    </ol>
  </nav>
  <h1>{k.name}</h1>
  <p class="klein">
    {k.beschreibung} · {produkte.length} Sorten
  </p>
  <ul class="raster">
    {produkte.map((p) => (
      <Produktkarte produkt={p} />
    ))}
  </ul>
</Shop>
