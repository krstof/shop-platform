---
import type { GetStaticPaths } from "astro";
import Shop from "../../layouts/Shop.astro";
import Teedose from "../../components/Teedose.astro";
import { PRODUKTE, SHOP, kategorie } from "../../vorschau/daten.js";
import { grundpreisText, mengeText, preisText, steuerText } from "../../vorschau/preis.js";

export const getStaticPaths = (() =>
  PRODUKTE.map((p) => ({ params: { slug: p.slug } }))) satisfies GetStaticPaths;

const p = PRODUKTE.find((x) => x.slug === Astro.params.slug);
if (p === undefined) throw new Error("Unbekanntes Produkt");
const k = kategorie(p.kategorie);
---

<Shop titel={p.name} beschreibung={p.kurz}>
  <nav class="pfadleiste" aria-label="Brotkrümelnavigation">
    <ol>
      <li>
        <a href="/">Startseite</a>
      </li>
      <li>
        <a href={`/kategorie/${k.slug}/`}>{k.name}</a>
      </li>
      <li>
        <a href={`/produkt/${p.slug}/`} aria-current="page">
          {p.name}
        </a>
      </li>
    </ol>
  </nav>
  <article class="produkt">
    <Teedose farbe={p.farbe} name={p.name} />
    <div>
      <h1>{p.name}</h1>
      <p class="klein">{p.kurz}</p>
      {p.merkmale.length > 0 && (
        <ul class="merkmale" aria-label="Merkmale">
          {p.merkmale.map((m) => (
            <li>{m}</li>
          ))}
        </ul>
      )}
      <p class="preis-gross">
        <strong>{preisText(p.preis)}</strong>
      </p>
      <p class="klein">
        {mengeText(p.gramm)} ({grundpreisText(p.preis, p.gramm)})<br />
        {steuerText(p.steuerBp)}
      </p>
      <div class="kaufen">
        <p>{p.lieferzeit}</p>
        <button class="knopf" type="button" disabled aria-describedby="kauf-hinweis">
          In den Warenkorb
        </button>
        <p id="kauf-hinweis" class="klein">
          In der Vorschau kann noch nicht gekauft werden.
        </p>
      </div>
      <h2>Beschreibung</h2>
      <p>{p.beschreibung}</p>
      <h2>Angaben</h2>
      <dl class="angaben">
        <dt>Zubereitung</dt>
        <dd>{p.zubereitung}</dd>
        <dt>Herkunft</dt>
        <dd>{p.herkunft}</dd>
        <dt>Füllmenge</dt>
        <dd>{mengeText(p.gramm)}</dd>
        <dt>Hersteller</dt>
        <dd>
          {SHOP.firma}, {SHOP.ort}
        </dd>
      </dl>
    </div>
  </article>
</Shop>
