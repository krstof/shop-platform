---
// Startseite eines Shops (M4, erweitert mit Shop-Editor Teil 2): großes Bild mit Überschrift und
// Text, hervorgehobene Produkte, Kategorien-Kacheln, danach alle Produkte. Was der Händler im
// Editor „Aussehen“ eingestellt und veröffentlicht hat, bestimmt Bild, Texte und Reihenfolge.
import Shop from "../../layouts/Shop.astro";
import Produktkarte from "../../components/Produktkarte.astro";
import { loadShop, storeApi, type StoreProduct } from "../../lib/store-api.js";
import { DEFAULT_HOME } from "../../lib/design.js";
import { warenkorbAnzahl } from "../../lib/cart.js";
import Sortierung from "../../components/Sortierung.astro";
import { sortierung } from "../../lib/sortierung.js";

const daten = await loadShop(Astro.params.shop);
if (daten === undefined) return Astro.rewrite("/404");
const { shop, categories } = daten;
const home = shop.design?.home ?? DEFAULT_HOME;

const sort = sortierung(Astro.url.searchParams.get("sortierung"));
const produkte = (await storeApi<{ data: StoreProduct[] }>(shop.handle, `/products?sort=${sort}`)).data;
const korb = await warenkorbAnzahl(Astro.cookies, shop.handle);

// Hervorgehobene Produkte in der vom Händler gewählten Reihenfolge; nicht mehr sichtbare fallen weg.
const nachId = new Map(produkte.map((p) => [p.id, p]));
const empfohlen = home.featuredProductIds
  .map((id) => nachId.get(id))
  .filter((p): p is StoreProduct => p !== undefined);

const titel = home.heroTitle !== "" ? home.heroTitle : `Willkommen bei ${shop.name}`;
const text = home.heroText !== "" ? home.heroText : "Schön, dass du da bist. Stöbere durch unser Sortiment.";
const sichtbareKategorien = home.showCategories ? categories : [];
---

<Shop shop={shop} categories={categories} titel={shop.name} korb={korb}>
  <section class:list={["buehne", { "buehne-bild": home.heroImage !== null }]} aria-labelledby="willkommen">
    {home.heroImage !== null && (
      <img
        class="buehne-foto"
        src={home.heroImage.url}
        alt=""
        width={home.heroImage.width}
        height={home.heroImage.height}
        fetchpriority="high"
      />
    )}
    <div class="buehne-text">
      <h1 id="willkommen">{titel}</h1>
      <p>{text}</p>
    </div>
  </section>

  {empfohlen.length > 0 && (
    <section aria-labelledby="empfohlen">
      <h2 id="empfohlen">Empfohlen</h2>
      <ul class="raster">
        {empfohlen.map((p) => (
          <Produktkarte produkt={p} shop={shop.handle} />
        ))}
      </ul>
    </section>
  )}

  {sichtbareKategorien.length > 0 && (
    <section aria-labelledby="kategorien-titel">
      <h2 id="kategorien-titel">Kategorien</h2>
      <ul class="kategorien">
        {sichtbareKategorien.map((k) => (
          <li>
            <a href={`/${shop.handle}/kategorie/${k.slug}`}>
              <strong>{k.name}</strong>
              {k.description && <span class="klein">{k.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <h2 id="alle">Alle Produkte</h2>
  {produkte.length > 1 && <Sortierung aktuell={sort} anzahl={produkte.length} anker="alle" />}
  {produkte.length === 0 ? (
    <p>Hier gibt es noch keine Produkte.</p>
  ) : (
    <ul class="raster">
      {produkte.map((p) => (
        <Produktkarte produkt={p} shop={shop.handle} />
      ))}
    </ul>
  )}
</Shop>
