---
// Startseite eines Shops (M4, erweitert mit Shop-Editor Teil 2): großes Bild mit Überschrift und
// Text, hervorgehobene Produkte, Kategorien-Kacheln, danach alle Produkte. Was der Händler im
// Editor „Aussehen“ eingestellt und veröffentlicht hat, bestimmt Bild, Texte und Reihenfolge.
import Shop from "../../layouts/Shop.astro";
import Produktkarte from "../../components/Produktkarte.astro";
import { loadShop, storeApi, type StoreProduct } from "../../lib/store-api.js";
import { DEFAULT_HOME, EXTERN_COOKIE, isSection, startseitenBausteine } from "../../lib/design.js";
import Bereich from "../../components/Bereich.astro";
import Baustein from "../../components/Baustein.astro";
import { warenkorbAnzahl } from "../../lib/cart.js";
import Sortierung from "../../components/Sortierung.astro";
import { sortierung } from "../../lib/sortierung.js";
import { nurVerfuegbar } from "../../lib/neu.js";

const daten = await loadShop(Astro.params.shop);
if (daten === undefined) return Astro.rewrite("/404");
const { shop, categories } = daten;
const home = shop.design?.home ?? DEFAULT_HOME;

const sort = sortierung(Astro.url.searchParams.get("sortierung"));
const verfuegbar = nurVerfuegbar(Astro.url.searchParams.get("verfuegbar"));
const filter = `&sort=${sort}${verfuegbar ? "&available=true" : ""}`;
const produkte = (await storeApi<{ data: StoreProduct[] }>(shop.handle, `/products?${filter.slice(1)}`)).data;
const korb = await warenkorbAnzahl(Astro.cookies, shop.handle);

const bausteine = startseitenBausteine(home);
const zeigt = (t: string) => bausteine.some((b) => b.type === t);
const extern = Astro.cookies.get(EXTERN_COOKIE)?.value === "ja";
// „Neu im Shop“: die vier neuesten lieferbaren Produkte (eigene Abfrage, unabhängig von der Sortierung unten).
const neu = !zeigt("new")
  ? []
  : (
      await storeApi<{ data: StoreProduct[] }>(shop.handle, "/products?sort=newest&available=true")
    ).data.slice(0, 4);
// Die erste Bühne ist die Hauptüberschrift; ohne Bühne gibt es eine unsichtbare.
const ersteBuehne = bausteine.find((b) => b.type === "hero")?.id;
---

<Shop shop={shop} categories={categories} titel={shop.name} korb={korb}>
  {ersteBuehne === undefined && <h1 class="unsichtbar">{shop.name}</h1>}
  {bausteine.map((b) =>
    isSection(b) ? (
      <Bereich
        block={b}
        home={home}
        shopName={shop.name}
        shop={shop.handle}
        produkte={produkte}
        neu={neu}
        kategorien={categories}
        hauptueberschrift={b.id === ersteBuehne}
      />
    ) : (
      <Baustein block={b} shop={shop.handle} extern={extern} />
    ),
  )}

  <h2 id="alle">Alle Produkte</h2>
  {(produkte.length > 1 || verfuegbar) && (
    <Sortierung nurVerfuegbar={verfuegbar} aktuell={sort} anzahl={produkte.length} anker="alle" />
  )}
  {produkte.length === 0 ? (
    <p>Hier gibt es noch keine Produkte.</p>
  ) : (
    <ul class="raster">
      {produkte.map((p) => (
        <Produktkarte produkt={p} shop={shop.handle} />
      ))}
    </ul>
  )}
</Shop>
