---
// Kasse (M6): als Gast mit E-Mail und Lieferadresse (nur Deutschland), danach Testzahlung.
// Ein Zufallsschlüssel im Formular (Idempotency-Key) verhindert doppelte Bestellungen bei
// doppeltem Klick oder Neuladen.
import { randomUUID } from "node:crypto";
import Shop from "../../layouts/Shop.astro";
import { euro } from "../../lib/format.js";
import { checkout, loadCart } from "../../lib/cart.js";
import { loadShop, StoreApiError } from "../../lib/store-api.js";

const daten = await loadShop(Astro.params.shop);
if (daten === undefined) return Astro.rewrite("/404");
const { shop, categories } = daten;
const basis = `/${shop.handle}`;

const felder = ["email", "firstName", "lastName", "street", "postalCode", "city"] as const;
type Feld = (typeof felder)[number];
const werte: Record<Feld, string> = {
  email: "",
  firstName: "",
  lastName: "",
  street: "",
  postalCode: "",
  city: "",
};
const fehler: Partial<Record<Feld, string>> = {};
let anmerkung = "";
let meldung = "";
let schluessel = randomUUID();

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  for (const f of felder)
    werte[f] = String(form.get(f) ?? "")
      .trim()
      .slice(0, 300);
  anmerkung = String(form.get("anmerkung") ?? "")
    .replace(/\r\n/g, "\n")
    .trim()
    .slice(0, 500);
  const k = String(form.get("schluessel") ?? "");
  if (/^[0-9a-f-]{36}$/.test(k)) schluessel = k;
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(werte.email))
    fehler.email = "Bitte eine gültige E-Mail-Adresse angeben.";
  if (!/^\d{5}$/.test(werte.postalCode)) fehler.postalCode = "Bitte eine fünfstellige Postleitzahl angeben.";
  for (const f of ["firstName", "lastName", "street", "city"] as const)
    if (werte[f] === "") fehler[f] = "Bitte ausfüllen.";
  if (Object.keys(fehler).length === 0) {
    try {
      await checkout(
        Astro.cookies,
        shop.handle,
        {
          email: werte.email,
          address: {
            firstName: werte.firstName,
            lastName: werte.lastName,
            street: werte.street,
            postalCode: werte.postalCode,
            city: werte.city,
          },
          ...(anmerkung === "" ? {} : { note: anmerkung }),
        },
        schluessel,
      );
      return Astro.redirect(`${basis}/testzahlung`, 303);
    } catch (e) {
      if (!(e instanceof StoreApiError) || e.status >= 500) throw e;
      meldung = e.message;
      for (const f of e.fields) {
        const name = f.path.split("/").pop() as Feld;
        if (felder.includes(name)) fehler[name] = f.message;
      }
    }
  } else meldung = "Bitte die markierten Felder prüfen.";
}

const korb = await loadCart(Astro.cookies, shop.handle);
if ((korb === undefined || korb.count === 0) && meldung === "")
  return Astro.redirect(`${basis}/warenkorb`, 303);

const beschriftung: Record<Feld, string> = {
  email: "E-Mail-Adresse",
  firstName: "Vorname",
  lastName: "Nachname",
  street: "Straße und Hausnummer",
  postalCode: "Postleitzahl",
  city: "Ort",
};
const autocomplete: Record<Feld, string> = {
  email: "email",
  firstName: "given-name",
  lastName: "family-name",
  street: "street-address",
  postalCode: "postal-code",
  city: "address-level2",
};
---

<Shop shop={shop} categories={categories} titel="Kasse" korb={korb?.count ?? 0}>
  <h1>Kasse</h1>
  <div class="kasse">
    <form method="post" class="formular" novalidate>
      {meldung && (
        <p class="meldung" role="alert">
          {meldung}
        </p>
      )}
      <input type="hidden" name="schluessel" value={schluessel} />
      <fieldset>
        <legend>Deine Angaben</legend>
        {felder.map((f) => (
          <div class="feld">
            <label for={f}>{beschriftung[f]}</label>
            <input
              id={f}
              name={f}
              type={f === "email" ? "email" : "text"}
              inputmode={f === "postalCode" ? "numeric" : undefined}
              autocomplete={autocomplete[f]}
              value={werte[f]}
              required
              aria-invalid={fehler[f] ? "true" : undefined}
              aria-describedby={fehler[f] ? `${f}-fehler` : undefined}
            />
            {f === "street" && (
              <ul
                class="adress-vorschlaege"
                data-vorschlaege
                hidden
                role="listbox"
                aria-label="Adressvorschläge"
              ></ul>
            )}
            {fehler[f] && (
              <span id={`${f}-fehler`} class="feld-fehler">
                {fehler[f]}
              </span>
            )}
          </div>
        ))}
        <p class="klein">Land: Deutschland. Wir liefern im Testshop nur nach Deutschland.</p>
        <div class="feld">
          <label for="anmerkung">Anmerkung zur Bestellung (freiwillig)</label>
          <textarea id="anmerkung" name="anmerkung" rows="3" maxlength="500">{anmerkung}</textarea>
        </div>
      </fieldset>
      <fieldset>
        <legend>Zahlung</legend>
        <p>
          Testzahlung: Du kannst auf der nächsten Seite „bezahlen“ oder „ablehnen“ wählen. Es fließt kein
          Geld.
        </p>
      </fieldset>
      <button class="knopf" type="submit">
        Zahlungspflichtig bestellen
      </button>
    </form>
    {korb && (
      <aside class="summen" aria-label="Deine Bestellung">
        <h2>Deine Bestellung</h2>
        <ul class="kurz-liste">
          {korb.lines.map((l) => (
            <li>
              {l.quantity} × {l.name} <span>{euro(l.lineTotal)}</span>
            </li>
          ))}
        </ul>
        <dl>
          {(korb.discount ?? 0) > 0 && (
            <>
              <dt>Gutschein {korb.couponCode}</dt>
              <dd class="rabatt">−{euro(korb.discount ?? 0)}</dd>
            </>
          )}
          <dt>Versand</dt>
          <dd>{korb.shipping === 0 ? "kostenlos" : euro(korb.shipping)}</dd>
          <dt class="gesamt">Gesamt</dt>
          <dd class="gesamt">{euro(korb.total)}</dd>
        </dl>
        <p class="klein">Alle Preise inkl. MwSt.</p>
      </aside>
    )}
  </div>
</Shop>

<script define:vars={{ basis }}>
  // Adressvorschläge (22.11.2026): Während der Kunde die Straße tippt, holt die Kasse passende
  // Adressen und füllt auf Klick Straße, Postleitzahl und Ort aus. Fällt der Dienst aus oder ist
  // er ausgeschaltet, kommt eine leere Liste, und das Formular verhält sich wie vorher.
  const feld = document.getElementById("street");
  const liste = document.querySelector("[data-vorschlaege]");
  if (feld instanceof HTMLInputElement && liste instanceof HTMLElement) {
    let laufend;
    let warte;
    const zu = () => {
      liste.hidden = true;
      liste.textContent = "";
    };
    const uebernehmen = (vorschlag) => {
      feld.value = vorschlag.street;
      for (const [name, wert] of [
        ["postalCode", vorschlag.postalCode],
        ["city", vorschlag.city],
      ]) {
        const ziel = document.getElementById(name);
        if (ziel instanceof HTMLInputElement) ziel.value = wert;
      }
      zu();
    };
    const suchen = async (text) => {
      laufend?.abort();
      laufend = new AbortController();
      try {
        const antwort = await fetch(`${basis}/adressvorschlaege?q=${encodeURIComponent(text)}`, {
          signal: laufend.signal,
          headers: { accept: "application/json" },
        });
        if (!antwort.ok) return zu();
        const { data } = await antwort.json();
        if (!Array.isArray(data) || data.length === 0) return zu();
        liste.textContent = "";
        for (const vorschlag of data) {
          const eintrag = document.createElement("li");
          const knopf = document.createElement("button");
          knopf.type = "button";
          knopf.textContent = vorschlag.label;
          knopf.addEventListener("click", () => uebernehmen(vorschlag));
          eintrag.append(knopf);
          liste.append(eintrag);
        }
        liste.hidden = false;
      } catch {
        // Abgebrochen oder kein Netz: einfach keine Vorschläge.
      }
    };
    feld.setAttribute("autocomplete", "off");
    feld.addEventListener("input", () => {
      window.clearTimeout(warte);
      const text = feld.value.trim();
      if (text.length < 3) return zu();
      warte = window.setTimeout(() => void suchen(text), 300);
    });
    feld.addEventListener("blur", () => window.setTimeout(zu, 200));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") zu();
    });
  }
</script>
