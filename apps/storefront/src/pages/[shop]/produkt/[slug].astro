---
// Produktseite (M4): Bilder, Preis mit Pflichtangaben, Beschreibung.
import Shop from "../../../layouts/Shop.astro";
import { absaetze, euro, lieferzeit, steuerHinweis } from "../../../lib/format.js";
import { formatText, plainText } from "@shop/text";
import { readMerkzettel } from "../../../lib/merkzettel.js";
import { loadShop, safeSlug, storeApi, StoreApiError, type StoreProduct } from "../../../lib/store-api.js";
import { warenkorbAnzahl } from "../../../lib/cart.js";
import Produktkarte from "../../../components/Produktkarte.astro";
import { aehnlicheProdukte } from "../../../lib/aehnliche.js";
import { bildNummer, zeigtVideo } from "../../../lib/galerie.js";
import { EXTERN_COOKIE, videoEmbedUrl } from "../../../lib/design.js";

const daten = await loadShop(Astro.params.shop);
const slug = safeSlug(Astro.params.slug);
if (daten === undefined || slug === undefined) return Astro.rewrite("/404");
const { shop, categories } = daten;
let p: StoreProduct;
try {
  p = await storeApi<StoreProduct>(shop.handle, `/products/${slug}`);
} catch (e) {
  if (e instanceof StoreApiError && e.status === 404) return Astro.rewrite("/404");
  throw e;
}
const k = categories.find((c) => c.id === p.categoryId);
// Galerie ohne JavaScript: ?bild=2 zeigt das zweite Bild groß (Klick auf ein kleines Bild).
const gewaehlt = bildNummer(Astro.url.searchParams.get("bild"), p.images.length);
const hauptbild = p.images[gewaehlt - 1];
// Video am Produkt (P5): Es steht als erstes Feld in der Galerie, groß kommt es erst auf Klick.
// So bleibt das Hauptbild vorn, das der Händler ausgesucht hat.
const video = p.video ?? null;
const videoGross = zeigtVideo(Astro.url.searchParams.get("bild"), video !== null);
const extern = Astro.cookies.get(EXTERN_COOKIE)?.value === "ja";
const einbettung =
  video === null || video.kind === "file" || video.providerId === null
    ? undefined
    : videoEmbedUrl(video.kind, video.providerId, video.autoplay);
const anbieter = video === null ? "" : video.kind === "youtube" ? "YouTube" : "Vimeo";
const korb = await warenkorbAnzahl(Astro.cookies, shop.handle);
// Aus derselben Kategorie; ohne Kategorie die neuesten anderen Produkte. Klappt das Laden nicht,
// fehlt nur dieser Abschnitt.
let aehnliche: StoreProduct[] = [];
try {
  const pfad = k === undefined ? "/products?sort=newest" : `/products?category=${k.slug}`;
  aehnliche = aehnlicheProdukte(p, (await storeApi<{ data: StoreProduct[] }>(shop.handle, pfad)).data);
} catch {
  aehnliche = [];
}
const gemerkt = readMerkzettel(Astro.cookies).includes(p.id);
---

<Shop
  shop={shop}
  categories={categories}
  titel={p.name}
  beschreibung={absaetze(plainText(p.description))[0] ?? p.name}
  korb={korb}
>
  <nav class="pfadleiste" aria-label="Brotkrümelnavigation">
    <ol>
      <li>
        <a href={`/${shop.handle}`}>Startseite</a>
      </li>
      {k && (
        <li>
          <a href={`/${shop.handle}/kategorie/${k.slug}`}>{k.name}</a>
        </li>
      )}
      <li>
        <a href={`/${shop.handle}/produkt/${p.slug}`} aria-current="page">
          {p.name}
        </a>
      </li>
    </ol>
  </nav>
  <article class="produkt">
    <div class="galerie">
      {videoGross && video !== null ? (
        video.kind === "file" ? (
          <video
            class="bild"
            src={video.url}
            controls
            preload="metadata"
            playsinline
            autoplay={video.autoplay}
            muted={video.autoplay}
          />
        ) : extern && einbettung !== undefined ? (
          <div class="einbettung video">
            <iframe
              src={einbettung}
              title={`Video zu ${p.name}`}
              loading="lazy"
              allow="encrypted-media; picture-in-picture; fullscreen"
              referrerpolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
            />
          </div>
        ) : (
          <div class="extern-hinweis">
            <p>
              <strong>Video zu {p.name}</strong>
            </p>
            <p class="klein">
              Hier ist Inhalt von {anbieter} eingebunden. Beim Anzeigen erhält {anbieter} Daten wie deine
              IP-Adresse.
            </p>
            <form method="post" action={`/${shop.handle}/externe-inhalte`}>
              <input type="hidden" name="zurueck" value={`${Astro.url.pathname}?bild=video`} />
              <button class="knopf" type="submit">
                Video anzeigen
              </button>
            </form>
          </div>
        )
      ) : hauptbild === undefined ? (
        <span class="bild bild-leer" aria-hidden="true" />
      ) : (
        /* Lupe (P5): Beim Überfahren mit der Maus wächst das Bild im Rahmen. Reines CSS, kein
           JavaScript; am Handy gibt es kein Überfahren, dort bleibt alles wie vorher. */
        <span class="bild-lupe">
          <img
            class="bild"
            src={hauptbild.url}
            alt={p.name}
            width={hauptbild.width}
            height={hauptbild.height}
          />
        </span>
      )}
      {(p.images.length > 1 || video !== null) && (
        <ul class="galerie-weitere" aria-label="Weitere Bilder">
          {video !== null && (
            <li>
              <a
                class:list={["galerie-wahl", "galerie-video", { aktiv: videoGross }]}
                href={`/${shop.handle}/produkt/${p.slug}?bild=video#inhalt`}
                aria-current={videoGross ? "true" : undefined}
              >
                <span class="bild video-kachel" aria-hidden="true">
                  <span class="video-pfeil" />
                </span>
                <span class="unsichtbar">Video zeigen</span>
              </a>
            </li>
          )}
          {p.images.map((b, i) => (
            <li>
              <a
                class:list={["galerie-wahl", { aktiv: i + 1 === gewaehlt && !videoGross }]}
                href={`/${shop.handle}/produkt/${p.slug}${i === 0 ? "" : `?bild=${i + 1}`}#inhalt`}
                aria-current={i + 1 === gewaehlt && !videoGross ? "true" : undefined}
              >
                <img
                  class="bild"
                  src={b.thumbnailUrl}
                  alt={`${p.name}, Bild ${i + 1} groß zeigen`}
                  width="400"
                  height="400"
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div>
      <h1>{p.name}</h1>
      {p.price !== null && (
        <>
          <p class="preis-gross">
            <strong class:list={{ "preis-angebot": p.compareAtPrice != null }}>{euro(p.price.amount)}</strong>
            {p.compareAtPrice != null && (
              <>
                {" "}
                <s class="preis-alt">
                  <span class="unsichtbar">statt </span>
                  {euro(p.compareAtPrice.amount)}
                </s>{" "}
                <span class="angebot-marke">Angebot</span>
              </>
            )}
          </p>
          <p class="klein">{steuerHinweis(p.taxRatePercent, shop.versand)}</p>
        </>
      )}
      <div class="kaufen">
        {p.inStock ? (
          <form method="post" action={`/${shop.handle}/warenkorb`} class="kauf-form">
            <input type="hidden" name="aktion" value="hinzufuegen" />
            <input type="hidden" name="produkt" value={p.id} />
            <label for="menge">Menge</label>
            <select id="menge" name="menge">
              {Array.from({ length: Math.min(p.maxQuantity, 10) }, (_, i) => (
                <option value={i + 1}>{i + 1}</option>
              ))}
            </select>
            <button class="knopf" type="submit">
              In den Warenkorb
            </button>
            <p class="klein">{lieferzeit(p.deliveryDays)}</p>
          </form>
        ) : (
          <p class="hinweis-aus">Zurzeit ausverkauft</p>
        )}
        <form method="post" action={`/${shop.handle}/merkzettel`} class="merken-form">
          <input type="hidden" name="produkt" value={p.id} />
          <input type="hidden" name="aktion" value={gemerkt ? "entfernen" : "merken"} />
          <input type="hidden" name="zurueck" value={Astro.url.pathname} />
          <button type="submit" class="knopf-merken" aria-pressed={gemerkt ? "true" : "false"}>
            <span aria-hidden="true">{gemerkt ? "♥" : "♡"}</span> {gemerkt ? "Gemerkt" : "Merken"}
          </button>
        </form>
      </div>
      {p.description.trim() !== "" && (
        <>
          <h2>Beschreibung</h2>
          <div class="text" set:html={formatText(p.description)} />
        </>
      )}
    </div>
  </article>
  {aehnliche.length > 0 && (
    <section class="aehnliche" aria-labelledby="aehnliche-titel">
      <h2 id="aehnliche-titel">Das könnte dir auch gefallen</h2>
      <ul class="raster">
        {aehnliche.map((a) => (
          <Produktkarte produkt={a} shop={shop.handle} />
        ))}
      </ul>
    </section>
  )}
</Shop>
