---
// Produktseite (M4): Bilder, Preis mit Pflichtangaben, Beschreibung.
import Shop from "../../../layouts/Shop.astro";
import { absaetze, euro, steuerHinweis } from "../../../lib/format.js";
import { loadShop, safeSlug, storeApi, StoreApiError, type StoreProduct } from "../../../lib/store-api.js";
import { warenkorbAnzahl } from "../../../lib/cart.js";
import Produktkarte from "../../../components/Produktkarte.astro";
import { aehnlicheProdukte } from "../../../lib/aehnliche.js";
import { bildNummer } from "../../../lib/galerie.js";

const daten = await loadShop(Astro.params.shop);
const slug = safeSlug(Astro.params.slug);
if (daten === undefined || slug === undefined) return Astro.rewrite("/404");
const { shop, categories } = daten;
let p: StoreProduct;
try {
  p = await storeApi<StoreProduct>(shop.handle, `/products/${slug}`);
} catch (e) {
  if (e instanceof StoreApiError && e.status === 404) return Astro.rewrite("/404");
  throw e;
}
const k = categories.find((c) => c.id === p.categoryId);
// Galerie ohne JavaScript: ?bild=2 zeigt das zweite Bild groß (Klick auf ein kleines Bild).
const gewaehlt = bildNummer(Astro.url.searchParams.get("bild"), p.images.length);
const hauptbild = p.images[gewaehlt - 1];
const korb = await warenkorbAnzahl(Astro.cookies, shop.handle);
// Aus derselben Kategorie; ohne Kategorie die neuesten anderen Produkte. Klappt das Laden nicht,
// fehlt nur dieser Abschnitt.
let aehnliche: StoreProduct[] = [];
try {
  const pfad = k === undefined ? "/products?sort=newest" : `/products?category=${k.slug}`;
  aehnliche = aehnlicheProdukte(p, (await storeApi<{ data: StoreProduct[] }>(shop.handle, pfad)).data);
} catch {
  aehnliche = [];
}
---

<Shop
  shop={shop}
  categories={categories}
  titel={p.name}
  beschreibung={absaetze(p.description)[0] ?? p.name}
  korb={korb}
>
  <nav class="pfadleiste" aria-label="Brotkrümelnavigation">
    <ol>
      <li>
        <a href={`/${shop.handle}`}>Startseite</a>
      </li>
      {k && (
        <li>
          <a href={`/${shop.handle}/kategorie/${k.slug}`}>{k.name}</a>
        </li>
      )}
      <li>
        <a href={`/${shop.handle}/produkt/${p.slug}`} aria-current="page">
          {p.name}
        </a>
      </li>
    </ol>
  </nav>
  <article class="produkt">
    <div class="galerie">
      {hauptbild === undefined ? (
        <span class="bild bild-leer" aria-hidden="true" />
      ) : (
        <img
          class="bild"
          src={hauptbild.url}
          alt={p.name}
          width={hauptbild.width}
          height={hauptbild.height}
        />
      )}
      {p.images.length > 1 && (
        <ul class="galerie-weitere" aria-label="Weitere Bilder">
          {p.images.map((b, i) => (
            <li>
              <a
                class:list={["galerie-wahl", { aktiv: i + 1 === gewaehlt }]}
                href={`/${shop.handle}/produkt/${p.slug}${i === 0 ? "" : `?bild=${i + 1}`}#inhalt`}
                aria-current={i + 1 === gewaehlt ? "true" : undefined}
              >
                <img
                  class="bild"
                  src={b.thumbnailUrl}
                  alt={`${p.name}, Bild ${i + 1} groß zeigen`}
                  width="400"
                  height="400"
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div>
      <h1>{p.name}</h1>
      {p.price !== null && (
        <>
          <p class="preis-gross">
            <strong class:list={{ "preis-angebot": p.compareAtPrice != null }}>{euro(p.price.amount)}</strong>
            {p.compareAtPrice != null && (
              <>
                {" "}
                <s class="preis-alt">
                  <span class="unsichtbar">statt </span>
                  {euro(p.compareAtPrice.amount)}
                </s>{" "}
                <span class="angebot-marke">Angebot</span>
              </>
            )}
          </p>
          <p class="klein">{steuerHinweis(p.taxRatePercent)}</p>
        </>
      )}
      <div class="kaufen">
        {p.inStock ? (
          <form method="post" action={`/${shop.handle}/warenkorb`} class="kauf-form">
            <input type="hidden" name="aktion" value="hinzufuegen" />
            <input type="hidden" name="produkt" value={p.id} />
            <label for="menge">Menge</label>
            <select id="menge" name="menge">
              {Array.from({ length: Math.min(p.maxQuantity, 10) }, (_, i) => (
                <option value={i + 1}>{i + 1}</option>
              ))}
            </select>
            <button class="knopf" type="submit">
              In den Warenkorb
            </button>
            <p class="klein">Sofort lieferbar.</p>
          </form>
        ) : (
          <p class="hinweis-aus">Zurzeit ausverkauft</p>
        )}
      </div>
      {absaetze(p.description).length > 0 && (
        <>
          <h2>Beschreibung</h2>
          {absaetze(p.description).map((a) => (
            <p class="text">{a}</p>
          ))}
        </>
      )}
    </div>
  </article>
  {aehnliche.length > 0 && (
    <section class="aehnliche" aria-labelledby="aehnliche-titel">
      <h2 id="aehnliche-titel">Das könnte dir auch gefallen</h2>
      <ul class="raster">
        {aehnliche.map((a) => (
          <Produktkarte produkt={a} shop={shop.handle} />
        ))}
      </ul>
    </section>
  )}
</Shop>
