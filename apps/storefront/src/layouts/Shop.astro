---
// Rahmen jeder Shop-Seite (M4): Kopf mit Shopname, Kategorien und Warenkorb, Fuß mit Preishinweis.
import "../styles/shop.css";
import type { StoreCategory, StoreShop } from "../lib/store-api.js";
import {
  DEFAULT_DESIGN,
  designVersion,
  isExternal,
  safeLink,
  safePageSlug,
  SOCIAL_NETWORKS,
  vorlage,
  webFontCssUrl,
} from "../lib/design.js";
import { readMerkzettel } from "../lib/merkzettel.js";
import { siFacebook, siInstagram, siPinterest, siTiktok, siX, siYoutube } from "simple-icons";
import { VERSAND_KOSTENLOS, versandText } from "../lib/format.js";

interface Props {
  shop: StoreShop;
  categories: readonly StoreCategory[];
  titel: string;
  beschreibung?: string;
  /** Anzahl der Artikel im Warenkorb (M6). */
  korb?: number;
  /** Text im Suchfeld (nur auf der Suchseite gefüllt). */
  suche?: string;
}
const { shop, categories, titel, beschreibung = shop.name, korb = 0, suche = "" } = Astro.props;
const pfad = Astro.url.pathname.replace(/\/+$/, "");
const basis = `/${shop.handle}`;
const design = shop.design ?? DEFAULT_DESIGN;
const merkzettel = readMerkzettel(Astro.cookies).length;
// Kopf- und Fußzeile (Shop-Editor Teil 3). Ältere Antworten ohne diese Felder: Standard.
const slogan = design.tagline ?? "";
const fussText = design.footer?.text ?? "";
// Symbole der sozialen Netzwerke (simple-icons, CC0), nur https-Profile.
const SYMBOLE = {
  instagram: siInstagram,
  facebook: siFacebook,
  tiktok: siTiktok,
  youtube: siYoutube,
  pinterest: siPinterest,
  x: siX,
} as const;
const sozial = SOCIAL_NETWORKS.flatMap((n) => {
  const url = design.footer?.social?.[n];
  return typeof url === "string" && /^https:\/\/[^\s<>"]+$/i.test(url)
    ? [{ name: SYMBOLE[n].title, url, path: SYMBOLE[n].path }]
    : [];
});
const schriften = webFontCssUrl(design);
// Eigene Seiten (Baukasten Teil 3) zuerst, danach die frei eingetragenen Links.
const fussLinks = [
  ...(design.pages ?? [])
    .filter((p) => p.inFooter && safePageSlug(p.slug) !== undefined)
    .map((p) => ({ label: p.title, url: `${basis}/seite/${p.slug}`, extern: false })),
  ...(design.footer?.links ?? []).flatMap((l) => {
    const url = safeLink(l.url);
    return url === undefined ? [] : [{ label: l.label, url, extern: isExternal(url) }];
  }),
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={beschreibung} />
    <title>{titel === shop.name ? titel : `${titel} – ${shop.name}`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {schriften !== undefined && <link rel="stylesheet" href={schriften} />}
    <link rel="stylesheet" href={`${basis}/design.css?v=${designVersion(design)}`} />
  </head>
  <body class={`vorlage-${vorlage(design)}`}>
    <a class="sprung" href="#inhalt">
      Zum Inhalt springen
    </a>
    <header class="kopf">
      <p class="vorschau-band" role="note">
        Testshop: Hier ist nichts echt, auch die Zahlung nicht.
      </p>
      <div class="breite kopf-innen">
        <div class="marke">
          <a href={basis} class="logo">
            {design.logo === null ? (
              shop.name
            ) : (
              <img
                class="logo-bild"
                src={design.logo.url}
                alt={shop.name}
                width={design.logo.width}
                height={design.logo.height}
              />
            )}
          </a>
          {slogan !== "" && <p class="slogan">{slogan}</p>}
        </div>
        <nav aria-label="Kategorien">
          <ul class="nav">
            {categories.map((k) => {
              const ziel = `${basis}/kategorie/${k.slug}`;
              return (
                <li>
                  <a href={ziel} aria-current={pfad === ziel ? "page" : undefined}>
                    {k.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="kopf-aktionen">
          <form class="suchfeld" role="search" action={`${basis}/suche`} method="get">
            <label class="unsichtbar" for="suche-q">
              Im Shop suchen
            </label>
            <input id="suche-q" type="search" name="q" value={suche} maxlength="100" placeholder="Suchen …" />
            <button type="submit">Suchen</button>
          </form>
          <div class="kopf-links">
            <a
              class="merk-link"
              href={`${basis}/merkzettel`}
              aria-current={pfad === `${basis}/merkzettel` ? "page" : undefined}
            >
              Merkzettel{merkzettel > 0 && ` (${merkzettel})`}
            </a>
            <a
              class="korb"
              href={`${basis}/warenkorb`}
              aria-current={pfad === `${basis}/warenkorb` ? "page" : undefined}
            >
              Warenkorb ({korb})
            </a>
          </div>
        </div>
      </div>
    </header>
    <main id="inhalt" class="breite" tabindex="-1">
      {shop.open === false ? (
        <section class="geschlossen" aria-labelledby="geschlossen-titel">
          <h1 id="geschlossen-titel">Gerade geschlossen</h1>
          <p>{shop.name} hat im Moment geschlossen. Schau bald wieder vorbei!</p>
        </section>
      ) : (
        <slot />
      )}
    </main>
    <footer class="fuss">
      <div class="breite fuss-innen">
        <div>
          <p class="logo">{shop.name}</p>
          {fussText !== "" && <p class="fuss-text">{fussText}</p>}
          {sozial.length > 0 && (
            <ul class="fuss-sozial" aria-label="Soziale Netzwerke">
              {sozial.map((n) => (
                <li>
                  <a
                    href={n.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={n.name}
                    title={n.name}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={n.path} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
        {fussLinks.length > 0 && (
          <nav aria-label="Weitere Links">
            <ul class="fuss-links">
              {fussLinks.map((l) => (
                <li>
                  <a
                    href={l.url}
                    aria-current={l.url === pfad ? "page" : undefined}
                    target={l.extern ? "_blank" : undefined}
                    rel={l.extern ? "noopener noreferrer" : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <p class="klein">Alle Preise inkl. MwSt., {versandText(shop.versand ?? VERSAND_KOSTENLOS)}.</p>
        <p class="klein slopify">
          <img src="/favicon.svg" alt="" width="16" height="16" /> Ein Testshop auf <strong>slopify</strong>
        </p>
      </div>
    </footer>
  </body>
</html>
