    "@shop/platform": "workspace:*",
    "@shop/pricing": "workspace:*",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "@shop/testing": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "kysely": "0.29.7",
