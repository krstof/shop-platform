# =============================================================================
# Caddy auf dem öffentlichen Testserver (docs/07_Testserver.md).
# Echtes Zertifikat (Let's Encrypt, Ersatz ZeroSSL) für TESTSERVER_DOMAIN.
# Die ganze Seite liegt hinter einem Passwort (nur Testdaten, Kollegen per Link).
# =============================================================================
{
	admin off
	servers {
		timeouts {
			read_header 10s
			idle 60s
		}
		max_header_size 32KB
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# Testserver soll in keiner Suchmaschine auftauchen.
		X-Robots-Tag "noindex, nofollow"
		-Server
		-Via
	}
}

{$TESTSERVER_DOMAIN} {
	import security_headers
	basic_auth {
		{$TESTSERVER_USER} {$TESTSERVER_PASSWORD_HASH}
	}
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	header Cache-Control "no-store"
	request_body {
		max_size 1MB
	}
	respond "Testserver der Shop-Plattform läuft. Die Anwendung folgt mit Etappe E18." 200
}

# Interner Gesundheitscheck für Docker, nicht nach außen veröffentlicht.
http://:2020 {
	respond "ok" 200
}
