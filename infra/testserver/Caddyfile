# =============================================================================
# Caddy auf dem öffentlichen Testserver (docs/07_Testserver.md).
# Echtes Zertifikat (Let's Encrypt, Ersatz ZeroSSL) für TESTSERVER_DOMAIN.
# Die ganze Seite liegt hinter einem Passwort (nur Testdaten, Kollegen per Link).
# =============================================================================
{
	admin off
	servers {
		timeouts {
			read_header 10s
			idle 60s
		}
		max_header_size 32KB
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# Testserver soll in keiner Suchmaschine auftauchen.
		X-Robots-Tag "noindex, nofollow"
		-Server
		-Via
	}
}

{$TESTSERVER_DOMAIN} {
	import security_headers
	basic_auth {
		{$TESTSERVER_USER} {$TESTSERVER_PASSWORD_HASH}
	}
	# Vorschau der Storefront: nur eigene Stylesheets und Bilder, kein Skript, keine Formulare nach außen.
	header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
	request_body {
		max_size 1MB
	}
	@nurLesen not method GET HEAD
	respond @nurLesen 405
	# Dateien mit Prüfsumme im Namen dürfen lange zwischengespeichert werden, Seiten nicht.
	@assets path /_assets/*
	header @assets Cache-Control "private, max-age=31536000, immutable"
	@seiten not path /_assets/*
	header @seiten Cache-Control "no-store"
	root * /srv/site
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# Interner Gesundheitscheck für Docker, nicht nach außen veröffentlicht.
http://:2020 {
	respond "ok" 200
}
