# Umgebung „Testserver“ (docs/07_Testserver.md): echte Zertifikate (Let's Encrypt), HSTS und keine
# Suchmaschinen. Seit 10.11.2026 ohne Seitenpasswort (Entscheidung Kristof): Shops, Backoffice und
# API sind öffentlich erreichbar; das Backoffice schützt die eigene Anmeldung, das Test-Postfach
# das Testpasswort (mail_guard). Es gibt nur Testdaten.

(server_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
	}
}

(guard) {
	import server_headers
}

(guard_api) {
	import server_headers
}

# Test-Postfach: Testpasswort (Benutzer team), Prüfwert aus test-login.env.
(mail_guard) {
	import server_headers
	basic_auth {
		{$MAIL_USER} {$MAIL_PASSWORD_HASH}
	}
}

(public_guard) {
	import server_headers
}

(root_site) {
	import server_headers
	redir https://shop.{$SHOP_DOMAIN}/ 308
}
