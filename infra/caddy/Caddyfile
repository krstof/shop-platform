# =============================================================================
# Caddy: einziger Eingang von außen (Sicherheit 3.2 „Grenze 1“, 5.5, 5.16).
# Lokal mit selbst erzeugten Zertifikaten (SIC-01). Die Inhalts-Sicherheitsregel
# (CSP) setzt jede Oberfläche selbst, weil sie Nonces braucht (Sicherheit 5.5).
# Weitere Adressen (backoffice, platform, Shops, pay) kommen mit ihren Etappen.
# =============================================================================
{
	# Keine Verwaltungsschnittstelle im Container (Härtung).
	admin off
	# Lokale Zertifikate statt Let's Encrypt (Antwort Kristof: kein öffentlicher Server).
	local_certs
	skip_install_trust
	servers {
		timeouts {
			read_header 10s
			idle 60s
		}
		max_header_size 32KB
		# Nur HTTP/1.1 und HTTP/2, UDP für HTTP/3 ist nicht freigegeben.
		protocols h1 h2
	}
}

# Gemeinsame Sicherheits-Header für alle Adressen (Sicherheit 5.5).
(security_headers) {
	# Cross-Origin-Resource-Policy setzt jede Adresse selbst (Bilder brauchen „cross-origin“).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# HSTS lokal aus, auf einem echten Server: max-age=63072000; includeSubDomains
		-Server
		-Via
	}
}

# Startseite: zeigt nur, dass die Plattform läuft.
{$SHOP_DOMAIN} {
	import security_headers
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	header Cross-Origin-Resource-Policy "same-site"
	header Cache-Control "no-store"
	request_body {
		max_size 1MB
	}
	respond "Shop-Plattform läuft." 200
}

# Grenzen für Anfragen an die API, gemeinsam für api.<Domain> und admin.<Domain>.
(api_limits)
{
	# Bild hochladen (M2 Teil 2): bis 12 MB (Bild bis 8 MB als Base64 im JSON), alles andere 1 MB.
	# Die API prüft dieselben Grenzen noch einmal je Endpunkt (bodyLimit).
	@image_upload {
		method POST
		path_regexp ^/admin/v1/products/[0-9a-f-]{36}/images$
	}
	@not_image_upload not {
		method POST
		path_regexp ^/admin/v1/products/[0-9a-f-]{36}/images$
	}
	request_body @image_upload {
		max_size 12MB
	}
	request_body @not_image_upload {
		max_size 1MB
	}
	# Zu große Anfragen schon hier ablehnen, sobald die Länge angekündigt ist. Sonst schneiden API und
	# Caddy gleichzeitig ab, und der Besucher sieht manchmal 502 statt 413 (Rauchtest 04.11.2026).
	@too_large expression `int({http.request.header.Content-Length}.size() == 0 ? "0" : {http.request.header.Content-Length}) > ({http.request.method} == "POST" && {http.request.uri.path}.matches("^/admin/v1/products/[0-9a-f-]{36}/images$") ? 12582912 : 1048576)`
	handle @too_large {
		header Content-Type "application/problem+json; charset=utf-8"
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond `{"type":"https://docs.shop.localhost/errors/payload_too_large","title":"Die Anfrage ist zu groß.","status":413,"code":"payload_too_large"}` 413 {
			close
		}
	}
	# Das Lebenszeichen ist nur für Docker, nicht für Besucher.
	@liveness path /livez
	handle @liveness {
		respond 404
	}
}

# Kern-Server: Admin-, Store- und Platform-API (Architektur 4). Sicherheits-Header, Fehler im Format
# Problem Details und die Anfragebremse kommen von der API selbst (ihre Header sind strenger als die
# gemeinsamen, etwa Referrer-Policy no-referrer). Caddy entfernt nur verräterische Header und setzt
# X-Forwarded-For neu: Was ein Besucher selbst mitschickt, übernimmt Caddy nicht.
api.{$SHOP_DOMAIN} {
	header {
		-Server
		-Via
	}
	import api_limits
	handle {
		reverse_proxy api:3000 {
			header_down -X-Powered-By
		}
	}
}

# Händler-Backoffice (M3). Die Oberfläche ruft die API unter derselben Adresse auf (/admin/v1 und
# /auth/v1), so passt das Sitzungs-Cookie __Host-shop_session ohne CORS. Alles andere sind die
# statischen Dateien aus dem Container backoffice, mit strenger Inhalts-Sicherheitsregel.
admin.{$SHOP_DOMAIN} {
	header {
		-Server
		-Via
	}
	import api_limits
	@api path /admin/v1/* /auth/v1/*
	handle @api {
		reverse_proxy api:3000 {
			header_down -X-Powered-By
		}
	}
	handle {
		import security_headers
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: https://media.{$SHOP_DOMAIN}; connect-src 'self'; font-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
			Cross-Origin-Resource-Policy "same-origin"
		}
		request_body {
			max_size 1MB
		}
		@write not method GET HEAD
		respond @write 405
		reverse_proxy backoffice:8080 {
			header_down -Server
		}
	}
}

# Test-Mails (Mailpit). Zusätzlich durch Mailpit selbst mit Passwort geschützt.
mail.{$SHOP_DOMAIN} {
	import security_headers
	header Cache-Control "no-store"
	header Cross-Origin-Resource-Policy "same-site"
	reverse_proxy mailpit:8025
}

# Bilder und Dokumente: eigene Adresse ohne Cookies (Sicherheit 5.7).
media.{$SHOP_DOMAIN} {
	import security_headers
	header {
		Cross-Origin-Resource-Policy "cross-origin"
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
		-Set-Cookie
	}
	@write not method GET HEAD OPTIONS
	respond @write 405
	reverse_proxy garage:3902 {
		header_up Host {$SHOP_S3_BUCKET_PUBLIC}.web.garage.internal
		header_down -Set-Cookie
	}
}

# Interner Gesundheitscheck für Docker, nicht nach außen veröffentlicht.
http://:2020 {
	respond "ok" 200
}
