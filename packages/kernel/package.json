{
  "name": "@shop/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Gemeinsamer Werkzeugkasten aller Module: Geld, Steuer, IDs, Fehler, Konfiguration, Protokoll, Mandanten-Transaktionen",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/db/migrate.d.ts",
      "default": "./dist/db/migrate.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  }
}
