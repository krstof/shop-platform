{
  "name": "@shop/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Testhilfen: Wegwerf-Datenbank PostgreSQL 18.6 per Testcontainers, eingerichtet mit dem Dienst migrate",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "shop-testdb": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "testcontainers": "12.2.1"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
