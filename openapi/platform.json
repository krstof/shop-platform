  "components": {
    "schemas": {
      "CreatedPlatformShop": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "handle": {
            "type": "string",
            "description": "Kurzname, Teil der Shop-Adresse (etwa teeladen.localhost)."
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "provisioning",
              "active",
              "suspended",
              "deleting",
              "deleted"
            ],
            "description": "active: geöffnet. suspended: gesperrt, niemand vom Shop kann sich dort anmelden."
          },
          "ownerEmail": {
            "description": "E-Mail-Adresse der Inhaberin beim Anlegen.",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "invitationSent": {
            "type": "boolean",
            "description": "false: Die Einladung an die Inhaberin ging nicht hinaus. Später im Backoffice erneut einladen."
          },
          "invitationExpiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bis dann gilt der Link in der Einladung."
          }
        },
        "required": [
          "id",
          "handle",
          "name",
          "status",
          "ownerEmail",
          "createdAt",
          "invitationSent",
          "invitationExpiresAt"
        ],
        "additionalProperties": false
      },
      "PlatformOperator": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "operator",
              "support",
              "viewer"
            ],
            "description": "owner: Inhaber der Plattform, operator: Betrieb, support: Hilfe für Händler, viewer: nur lesen."
          }
        },
        "required": [
          "userId",
          "role"
        ],
        "additionalProperties": false
      },
      "PlatformShop": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "handle": {
            "type": "string",
            "description": "Kurzname, Teil der Shop-Adresse (etwa teeladen.localhost)."
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "provisioning",
              "active",
              "suspended",
              "deleting",
              "deleted"
            ],
            "description": "active: geöffnet. suspended: gesperrt, niemand vom Shop kann sich dort anmelden."
          },
          "ownerEmail": {
            "description": "E-Mail-Adresse der Inhaberin beim Anlegen.",
            "type": [
              "string",
