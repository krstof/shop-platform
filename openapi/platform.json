{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop-Plattform Platform API",
    "description": "API der Plattform-Verwaltung (Betreiber). Kein Zugriff auf Shopdaten.",
    "version": "1.0.0"
  },
  "paths": {
    "/platform/v1/operator": {
      "get": {
        "operationId": "getPlatformOperator",
        "summary": "Wer bin ich als Betreiber",
        "description": "Liefert das Betreiberkonto der Sitzung und seine Rolle. Nur mit bestätigtem zweitem Faktor; ohne Zwei-Faktor oder ohne Betreiberkonto 403. Die Sitzung endet nach 1 Stunde ohne Aktivität, spätestens 12 Stunden nach der Anmeldung.",
        "tags": [
          "Plattform"
        ],
        "responses": {
          "200": {
            "description": "Betreiberkonto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformOperator"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Berechtigung fehlt; bei ändernden Anfragen auch: Anfrage von einer fremden Seite (Origin).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          }
        ],
        "x-required-scopes": [
          "platform:read"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PlatformOperator": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "operator",
              "support",
              "viewer"
            ],
            "description": "owner: Inhaber der Plattform, operator: Betrieb, support: Hilfe für Händler, viewer: nur lesen."
          }
        },
        "required": [
          "userId",
          "role"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Feste, maschinenlesbare Kennung des Fehlers."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "JSON Pointer auf das Feld, z. B. /body/name."
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "Fehler im Format Problem Details (RFC 9457)."
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "shop_session",
        "description": "Sitzungs-Cookie nach der Anmeldung über /auth/v1/sign-in. Der Browser schickt es unter dem Namen __Host-shop_session (HttpOnly, Secure, SameSite=Lax)."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-Token mit Präfix shp_at_, gebunden an einen Shop und eine Liste von Berechtigungen."
      }
    }
  }
}
