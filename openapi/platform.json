          {
            "session": []
          },
          {
            "apiToken": []
          }
        ],
        "x-required-scopes": [
          "platform:read"
        ]
      },
      "post": {
        "operationId": "createPlatformShop",
        "summary": "Shop anlegen",
        "description": "Legt einen Shop an, der sofort geöffnet ist, und lädt die Inhaberin per E-Mail ein. Mit dem Link wählt sie ihr Passwort (gibt es das Konto schon, bleibt es) und kommt danach ins Backoffice. Kurzname schon vergeben oder für Seiten des Backoffice reserviert (etwa plattform): 409.",
        "tags": [
          "Plattform"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Zufällige Kennung je Vorgang. Eine Wiederholung mit demselben Schlüssel liefert die gespeicherte Antwort (24 Stunden).",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,255}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "handle": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])$",
                    "description": "Kurzname: Kleinbuchstaben, Ziffern und Bindestriche, 3 bis 63 Zeichen."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Name des Shops, wie Kundinnen ihn sehen."
                  },
                  "ownerEmail": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 320,
                    "description": "E-Mail-Adresse der Inhaberin oder des Inhabers."
                  }
                },
                "required": [
                  "handle",
                  "name",
                  "ownerEmail"
                ],
                "additionalProperties": false
              },
              "example": {
                "handle": "teeladen",
                "name": "Teeladen",
                "ownerEmail": "inhaberin@teeladen.example"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Angelegt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedPlatformShop"
                }
              }
            }
          },
          "400": {
            "description": "Die Anfrage ist fehlerhaft (zum Beispiel kaputtes JSON).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Berechtigung fehlt; bei ändernden Anfragen auch: Anfrage von einer fremden Seite (Origin).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Die Aktion passt nicht zum aktuellen Zustand (oder dieselbe Anfrage läuft noch).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Die Anfrage ist größer als 1 MB.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Nur application/json wird angenommen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Die Eingabe ist ungültig. Die Felder stehen in errors.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          }
        ],
        "x-required-scopes": [
          "platform:write"
        ]
      }
    },
