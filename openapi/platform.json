{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop-Plattform Platform API",
    "description": "API der Plattform-Verwaltung (Betreiber). Kein Zugriff auf Shopdaten.",
    "version": "1.0.0"
  },
  "paths": {
    "/platform/v1/operator": {
      "get": {
        "operationId": "getPlatformOperator",
        "summary": "Wer bin ich als Betreiber",
        "description": "Liefert das Betreiberkonto der Sitzung und seine Rolle. Nur mit bestätigtem zweitem Faktor; ohne Zwei-Faktor oder ohne Betreiberkonto 403. Die Sitzung endet nach 1 Stunde ohne Aktivität, spätestens 12 Stunden nach der Anmeldung.",
        "tags": [
          "Plattform"
        ],
        "responses": {
          "200": {
            "description": "Betreiberkonto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformOperator"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Berechtigung fehlt; bei ändernden Anfragen auch: Anfrage von einer fremden Seite (Origin).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          }
        ],
        "x-required-scopes": [
          "platform:read"
        ]
      }
    },
    "/platform/v1/shops": {
      "get": {
        "operationId": "listPlatformShops",
        "summary": "Shops auflisten",
        "description": "Listet alle Shops der Plattform mit Zustand, älteste zuerst. Gelöschte fehlen.",
        "tags": [
          "Plattform"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Einträge pro Seite, 1 bis 100 (Standard 25).",
            "schema": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Lesemarke aus `page.nextCursor` der vorigen Seite.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eine Seite mit Shops.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlatformShop"
                      }
                    },
                    "page": {
                      "type": "object",
                      "properties": {
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "nextCursor",
                        "hasMore"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data",
                    "page"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Berechtigung fehlt; bei ändernden Anfragen auch: Anfrage von einer fremden Seite (Origin).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Die Eingabe ist ungültig. Die Felder stehen in errors.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
