        "tags": [
          "Anmeldung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "description": "Aktuelles Passwort des Kontos."
                  }
                },
                "required": [
                  "password"
                ],
                "additionalProperties": false
              },
              "example": {
                "password": "drei kleine teekannen"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Geheimnis und Ersatzcodes. Nur in dieser Antwort sichtbar.",
            "headers": {
