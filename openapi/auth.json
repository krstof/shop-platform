    "/auth/v1/two-factor/verify": {
      "post": {
        "operationId": "verifySecondFactor",
        "summary": "Zweiten Faktor eingeben",
        "description": "Zweiter Schritt der Anmeldung für Konten mit Zwei-Faktor: Code aus der Authenticator-App (6 Ziffern, jeder Code gilt nur einmal) oder ein Ersatzcode. Danach gilt die Sitzung. Nach 5 falschen Codes ist die Sitzung beendet und die Anmeldung beginnt mit dem Passwort neu. Falsche, schon benutzte und abgelaufene Codes ergeben dieselbe Antwort.",
        "tags": [
          "Anmeldung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "6 Ziffern aus der Authenticator-App oder ein Ersatzcode wie abcde-fghjk."
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              },
              "example": {
                "code": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bestätigt. Die Sitzung gilt.",
            "headers": {
              "Set-Cookie": {
                "description": "Setzt oder löscht das Sitzungs-Cookie __Host-shop_session.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
