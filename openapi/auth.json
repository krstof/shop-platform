          "Anmeldung"
        ],
        "responses": {
          "200": {
            "description": "Abgemeldet. Set-Cookie löscht das Cookie.",
            "headers": {
              "Set-Cookie": {
                "description": "Setzt oder löscht das Sitzungs-Cookie __Host-shop_session.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedOut"
                }
              }
            }
          },
          "403": {
