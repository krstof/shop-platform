{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop-Plattform Auth API",
    "description": "Anmelden, Abmelden und eigene Sitzung für Backoffice und Plattform-Verwaltung. Die Sitzung steckt im Cookie __Host-shop_session (HttpOnly, Secure, SameSite=Lax). Ändernde Anfragen aus dem Browser müssen von einer erlaubten Oberfläche kommen (Origin), sonst 403.",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/v1/session": {
      "get": {
        "operationId": "getCurrentSession",
        "summary": "Wer bin ich",
        "description": "Liefert das angemeldete Konto, die laufende Sitzung und die Shops, in denen das Konto arbeiten darf. Ohne gültige Sitzung 401.",
        "tags": [
          "Anmeldung"
        ],
        "responses": {
          "200": {
            "description": "Konto, Sitzung und Shops.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-signed-in": true
      }
    },
    "/auth/v1/sign-in": {
      "post": {
        "operationId": "signIn",
        "summary": "Anmelden",
        "description": "Meldet mit E-Mail und Passwort an und setzt das Sitzungs-Cookie __Host-shop_session (HttpOnly, Secure, SameSite=Lax). Eine schon vorhandene Sitzung dieses Browsers wird beendet. Unbekannte E-Mail und falsches Passwort ergeben dieselbe Antwort. Nach 5 Fehlversuchen je Konto oder Netz kommt 429 mit wachsender Wartezeit (höchstens 60 s), nach 20 wird das Konto 15 Minuten gesperrt. Hat das Konto Zwei-Faktor, steht in der Antwort secondFactor: required; die Sitzung gilt dann erst nach POST /auth/v1/two-factor/verify.",
        "tags": [
          "Anmeldung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 320,
                    "description": "E-Mail-Adresse des Kontos (Groß- und Kleinschreibung egal)."
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              },
              "example": {
                "email": "inhaberin@teeladen.example",
                "password": "drei kleine teekannen"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Angemeldet. Das Cookie steht in Set-Cookie.",
            "headers": {
              "Set-Cookie": {
                "description": "Setzt oder löscht das Sitzungs-Cookie __Host-shop_session.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            }
          },
          "400": {
            "description": "Die Anfrage ist fehlerhaft (zum Beispiel kaputtes JSON).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Nicht angemeldet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Berechtigung fehlt; bei ändernden Anfragen auch: Anfrage von einer fremden Seite (Origin).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Die Anfrage ist größer als 1 MB.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Nur application/json wird angenommen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Die Eingabe ist ungültig. Die Felder stehen in errors.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Sekunden bis zum nächsten Versuch.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Unerwarteter Fehler, ohne Einzelheiten. requestId hilft bei der Suche im Protokoll.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [],
        "x-public": true,
        "x-public-reason": "Wer sich anmeldet, hat noch keine Sitzung."
      }
    },
    "/auth/v1/sign-out": {
      "post": {
        "operationId": "signOut",
        "summary": "Abmelden",
        "description": "Beendet die Sitzung dieses Browsers in der Datenbank und löscht das Cookie. Klappt auch, wenn die Sitzung schon abgelaufen ist; die Antwort ist dann dieselbe.",
