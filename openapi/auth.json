  "components": {
    "schemas": {
      "CurrentSession": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email"
            ],
            "additionalProperties": false
          },
          "session": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "Endet ohne Aktivität zu diesem Zeitpunkt; jede Anfrage schiebt ihn nach vorn (höchstens 7 Tage ab Anmeldung)."
              }
            },
            "required": [
              "id",
              "createdAt",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "shops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopOfUser"
            },
            "description": "Shops, in denen das Konto arbeiten darf. Leer, solange es zu keinem aktiven Shop gehört oder der zweite Faktor noch fehlt."
          },
          "secondFactor": {
            "type": "string",
            "enum": [
              "required",
              "verified",
              "not_enrolled"
            ],
            "description": "required: Passwort stimmt, jetzt den Code aus der Authenticator-App an POST /auth/v1/two-factor/verify schicken (innerhalb von 10 Minuten); bis dahin gilt die Sitzung nirgends. verified: zweiter Faktor bestätigt. not_enrolled: Konto ohne zweiten Faktor."
          }
        },
        "required": [
          "user",
          "session",
          "shops",
          "secondFactor"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Feste, maschinenlesbare Kennung des Fehlers."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "JSON Pointer auf das Feld, z. B. /body/name."
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "Fehler im Format Problem Details (RFC 9457)."
      },
      "ShopOfUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Kennung des Shops. Als Kopfzeile Shop-Id an jede Anfrage der Admin-API hängen."
          },
          "handle": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "staff"
            ],
            "description": "owner: Inhaberin oder Inhaber, staff: Mitarbeiterin oder Mitarbeiter."
          }
        },
        "required": [
          "id",
          "handle",
          "name",
          "role"
        ],
        "additionalProperties": false
      },
      "SignedOut": {
        "type": "object",
        "properties": {
          "signedOut": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "signedOut"
        ],
        "additionalProperties": false
      },
      "TwoFactorSetup": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Geheimnis zum Abtippen in die App (Base32), falls kein QR-Code geht."
          },
          "otpauthUri": {
            "type": "string",
            "description": "Inhalt des QR-Codes für die Authenticator-App."
          },
          "backupCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "10 Ersatzcodes, je einmal gültig. Werden nur jetzt gezeigt; sicher aufbewahren."
          }
        },
        "required": [
          "secret",
          "otpauthUri",
          "backupCodes"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "shop_session",
        "description": "Sitzungs-Cookie nach der Anmeldung über /auth/v1/sign-in. Der Browser schickt es unter dem Namen __Host-shop_session (HttpOnly, Secure, SameSite=Lax)."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-Token mit Präfix shp_at_, gebunden an einen Shop und eine Liste von Berechtigungen."
      }
    }
  }
}
